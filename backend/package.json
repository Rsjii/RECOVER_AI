{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r dotenv/config src/server.ts\"",
    "dev:simple": "ts-node -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/server.js --worker-only",
    "typecheck": "tsc --noEmit",
    "test:seed": "node -r dotenv/config test/seed.js",
    "test:platform": "node -r dotenv/config test/scripts/05-platform.test.js",
    "test:auth": "node -r dotenv/config test/scripts/01-auth.test.js",
    "test:stripe": "node -r dotenv/config test/scripts/02-stripe.test.js",
    "test:ai": "node -r dotenv/config test/scripts/03-ai.test.js",
    "test:email": "node -r dotenv/config test/scripts/04-email.test.js",
    "test:modules": "npm run test:platform && npm run test:auth && npm run test:stripe && npm run test:ai && npm run test:email",
    "ops:backup-evidence": "node -r dotenv/config scripts/backup_restore_evidence.js",
    "ops:weekly-governance": "node -r dotenv/config scripts/weekly_governance_report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.70.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-slow-down": "^3.0.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.19.0",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "resend": "^6.9.3",
    "stripe": "^20.4.0",
    "twilio": "^5.13.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@types/stripe": "^8.0.416",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
