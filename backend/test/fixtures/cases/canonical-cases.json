    { "name": "refresh_with_cookie", "method": "POST", "path": "/api/auth/refresh", "expectedStatus": 200, "authRequired": true },
    { "name": "refresh_without_cookie", "method": "POST", "path": "/api/auth/refresh", "expectedStatus": 401 },
