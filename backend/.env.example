# Server
NODE_ENV=development
PORT=3000

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/recoverai

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=generate_with_openssl_rand_hex_32
REFRESH_TOKEN_SECRET=generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
ADMIN_SECRET=admin_secret_here

# URLs
FRONTEND_URL=http://localhost:3173
CORS_ORIGINS=http://localhost:3173,http://localhost:5173,http://localhost:3001
BACKEND_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Stripe (Customer billing integration)
STRIPE_API_KEY=sk_test_...
STRIPE_CLIENT_ID=ca_...
STRIPE_CLIENT_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# QuickBooks (get from developer.intuit.com)
QB_CLIENT_ID=ABcdef...
QB_CLIENT_SECRET=ABcdef...
QB_ENVIRONMENT=sandbox

# Email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Slack (optional — for real-time alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

#Twilio (optional — for SMS alerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890
